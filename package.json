{
  "name": "music-ear",
  "private": true,
  "type": "module",
  "description": "Ear training web app — a zero-dependency, no-build static site. This manifest exists only so Node can run the test suite; the app itself ships the repository root as-is.",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "deploy": "node scripts/deploy.mjs",
    "android": "node scripts/build-android.mjs",
    "android:en": "node scripts/build-android.mjs --lang=en",
    "android:release": "node scripts/build-android.mjs --task=assembleRelease",
    "android:en:release": "node scripts/build-android.mjs --task=assembleRelease --lang=en",
    "android:icons": "E:/software/miniforge/python.exe scripts/make-icons.py",
    "android:model": "node scripts/fetch-asr-model.mjs",
    "i18n": "node scripts/build-i18n.mjs"
  }
}

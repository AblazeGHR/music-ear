<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: same dark background as the app, so launch
         feels like the page fading in rather than a white flash. -->
    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
